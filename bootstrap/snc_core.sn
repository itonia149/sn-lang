# Stage-1 compiler seed, written in Sn using ONLY sfunc declarations.
# It compiles the original flat arithmetic core:
#   { print 42 }
#   { print { add 20 22 } }
# including permutations of the operator tokens at those two levels.

sfunc clean(src:str) -> str = { trim { replace { replace { replace { replace src "{" " " } "}" " " } "print" " " } "add" " " } };

sfunc first_number(src:str) -> i64 = { atoi { word { clean src } 0 } };
sfunc second_number(src:str) -> i64 = { atoi { word { clean src } 1 } };

sfunc value(src:str) -> i64 = { if { contains src "add" }
    { add { first_number src } { second_number src } }
    { first_number src }
};

sfunc emit_i64(n:i64) -> str = { concat
    "; generated by Sn stage-1 core compiler\n@.fmt = private unnamed_addr constant [5 x i8] c\"%ld\\0A\\00\"\ndeclare i32 @printf(ptr, ...)\ndefine i32 @main() {\nentry:\n  call i32 (ptr, ...) @printf(ptr @.fmt, i64 "
    { concat { itoa n } ")\n  ret i32 0\n}\n" }
};

sfunc compile(src:str) -> str = { emit_i64 { value src } };

main = { writefile { arg 2 } { compile { readfile { arg 1 } } } };
